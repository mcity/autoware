<?xml version="1.0"?>
<package format="3">
  <name>pursuit_control</name>
  <version>1.0.0</version>
  <description>Pure Pursuit lateral controller with cascaded PID speed control — Python ROS2 package</description>

  <maintainer email="rpatnaik@umich.edu">Raj</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mcity_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
